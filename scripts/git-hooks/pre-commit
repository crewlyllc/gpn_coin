#!/usr/bin/env bash
# Single-writer guard (2026-11-21).
#
# WHY: on 2026-11-21 the assistant treated an owner approval ("do the spec bump") as permission to
# execute a list row immediately — spawning a runtime upgrade while a release was still open. The
# rule that should have stopped it ("one writer; rows are executed at bundle time") existed only as
# prose. This hook makes it mechanical: SOURCE changes cannot be committed unless a bundle is open.
#
# A bundle is open when `docs/releases/<version>.md` exists AND is not yet archived — i.e. work is
# being done inside a version, by the one agent working the list, not as a side action.
set -u
source_changed=$(git diff --cached --name-only | grep -E '^(gpn-agent/src|gpn-node/|install\.(sh|ps1)|scripts/[a-z0-9-]+\.(sh|py|ps1))' || true)
[ -z "$source_changed" ] && exit 0

# A published version is CLOSED: a deep clone already served it to strangers.
published=$(/usr/bin/python3 -c "import json;print(json.load(open('network.json')).get('latest_version',''))" 2>/dev/null)
# The OPEN bundle is the newest checklist version that is NEWER than what is published.
# Old checklists lying around (0.3.52–0.3.59 are still unfiled) must not count as "a bundle is open".
highest=$(ls docs/releases/[0-9]*.md 2>/dev/null | sed 's#.*/##; s#\.md$##' | sort -V | tail -1)
open_bundle=""
if [ -n "$highest" ] && [ "$highest" != "${published:-$highest}" ]; then
  # numeric "greater than": sort -V places the larger version last
  newer=$(printf '%s\n%s\n' "${published:-0.0.0}" "$highest" | sort -V | tail -1)
  [ "$newer" = "$highest" ] && open_bundle="$highest"
fi

if [ -z "$open_bundle" ]; then
  cat >&2 <<'MSG'
REFUSED: source changes with no open bundle.

The unit of work is a row in GPN-LIST.md, executed inside a version by the single agent that works
the list. An owner "yes" approves a row — it does not authorise a side action in the chat session.

Do one of these:
  * add/finish a row in GPN-LIST.md and let the release loop bundle it, or
  * open the next version deliberately: docs/releases/<next>.md (generated by
    scripts/make-release-checklist.py), which is what marks a bundle as open.

(docs-only commits are unaffected by this hook)
MSG
  exit 1
fi
exit 0
